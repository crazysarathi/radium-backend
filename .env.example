# ── Application ──────────────────────────────────────────────
APP_NAME="Radium API"
APP_ENV=development            # development | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Public URL the API is reachable at (used to build absolute file URLs)
PUBLIC_BASE_URL=http://localhost:8000

# ── Security ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ── Database (PostgreSQL) ─────────────────────────────────────
# Point these at a PostgreSQL server you can already connect to.
# Create the database first, e.g.: psql -U <user> -c "CREATE DATABASE radium;"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=radium
# Optional: full DSN override (takes precedence over the parts above)
# DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/radium
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── CORS ─────────────────────────────────────────────────────
# Local dev (any localhost/LAN origin, any port) and any *.vercel.app
# deployment (prod + previews) are already allowed via CORS_ORIGIN_REGEX in
# app/core/config.py — nothing to configure for those. Only set this for
# additional EXACT origins the regex doesn't cover, e.g. a custom domain:
# CORS_ORIGINS=https://admin.radium.com

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
# memory:// for a single process; point at Redis later, e.g. redis://localhost:6379
RATE_LIMIT_STORAGE_URI=memory://
# Only set true when a reverse proxy YOU control sits in front and sets/strips
# X-Forwarded-For — otherwise clients can spoof it to dodge rate limits and to
# poison the IP address recorded on login sessions.
TRUST_PROXY_HEADERS=false

# ── File uploads ─────────────────────────────────────────────
STORAGE_BACKEND=local          # local (s3 / supabase / cloudinary later)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
# svg is deliberately excluded — it can carry <script> and would execute
# when served inline from the API origin.
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,webp,gif,pdf

# ── Email (console backend logs instead of sending) ──────────
EMAIL_BACKEND=console          # console | smtp (later)
EMAIL_FROM=no-reply@radium.local
# Frontend URL used inside password-reset emails
FRONTEND_RESET_PASSWORD_URL=http://localhost:5174/reset-password

# ── First superuser (created by `python -m app.db.seed`) ─────
# Matches the demo credentials the radium-admin frontend displays on its login page.
FIRST_SUPERUSER_EMAIL=admin@radium.example
FIRST_SUPERUSER_PASSWORD=radium@2026
FIRST_SUPERUSER_NAME="Radium Admin"
